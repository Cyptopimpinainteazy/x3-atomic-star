# This is a user unit, so `%h` expands to the invoking user's home. The checkout is addressed as
# %h/Desktop/xxxstar-main rather than the old hardcoded layout; update the ExecStart path if you
# move the checkout.
[Unit]
Description=Cloudflare Tunnel for X3
After=network.target x3-desktop.service x3fronend.service
Wants=x3-desktop.service x3fronend.service
StartLimitIntervalSec=0

[Service]
Type=simple
Restart=always
RestartSec=10
ExecStart=/usr/bin/env cloudflared --config %h/Desktop/xxxstar-main/infra/cloudflare-tunnel/config.yml tunnel run atlas-sphere
StandardOutput=journal
StandardError=journal
KillMode=process

[Install]
WantedBy=default.target
